# ---- Google Apps Script backend (server-side only, never exposed to the browser) ----
# Web App URL from Apps Script → Deploy → Manage deployments (ends with /exec)
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec
# Must equal the API_PROXY_SECRET Script Property. Requests without it are rejected by Apps Script.
API_PROXY_SECRET=change-me-to-a-long-random-string

# ---- Website ----
NEXT_PUBLIC_SITE_URL=https://www.your-association.org
# Seconds a public page may be served from cache before refreshing from Google Sheets
REVALIDATE_SECONDS=60
# Fallback only — the live value comes from the Settings sheet (TIMEZONE)
ASSOCIATION_TIMEZONE=Asia/Kolkata

# ---- Optional ----
# Google Sign-In OAuth client ID (also set GOOGLE_CLIENT_ID Script Property to the same value)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Razorpay: the key id/secret live in Apps Script Script Properties.
# The webhook URL to configure in Razorpay is  {NEXT_PUBLIC_SITE_URL}/api/payments/webhook

# ---- Local development with the mock backend (npm run mock:api) ----
# APPS_SCRIPT_URL=http://localhost:8787
# API_PROXY_SECRET=dev-proxy-secret
